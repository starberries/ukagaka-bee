//=== DiamondWrap(text, lines, maxwidth) ===
/*
  _lines:    3, 5, 7, 9, or 11
  _maxwidth: est. characters for the widest line
  todo: score line widths based on characters (i = 1, a = 3, W = 5, etc)
*/

DiamondWrap
{
  _rawText = _argv[0]
  _text = RemoveSakuraScript(_rawText)
  _lines = TOINT(_argv[1]) // todo: figure this one out later
  _maxwidth = 30 // todo: make a variable for this later?

  _profile = IARRAY
  _limits = IARRAY

  if _lines == 3
    _profile = (0.50, 1.00, 0.50)
  elseif _lines == 5
    _profile = (0.35, 0.70, 1.00, 0.70, 0.35)
  elseif _lines == 7
    _profile = (0.25, 0.50, 0.75, 1.00, 0.75, 0.50, 0.25)
  elseif _lines == 9
    _profile = (0.25, 0.43, 0.61, 0.82, 1.00, 0.82, 0.61, 0.43, 0.25)
  else
  {
    _profile = (0.24, 0.40, 0.56, 0.72, 0.86, 1.00, 0.86, 0.72, 0.56, 0.40, 0.24)
    _lines = 11 // todo: is defaulting this a good idea?
  }

  _words = SPLIT(_text, " ")
  _wordcount = ARRAYSIZE(_words)

  // Get character limit for each line
  for i = 0; i < _lines; i++
  {
    _limits[i] = FLOOR(_maxwidth * _profile[i])
    if _limits[i] < 1; _limits[i] = 1
  }

  // Fill each line as close to its width as possible
  _result = ""
  _wordindex = 0

  _currentLine = 0
  _currentString = ""
  _stringToCheck = ""

  for _currentLine; _currentLine < _lines; _currentLine++
  {
    for _wordindex; _wordindex < _wordcount; _wordindex++
    {
      if _currentString == ""
        // If nothing's been added to the string yet, add first word
        _stringToCheck = _words[_wordindex]
      else
        // else, add next word to the in-progress string
        _stringToCheck = _currentString + " " + _words[_wordindex]

      // If the string isn't too long, update _currentString and keep going
      if STRLEN(_stringToCheck) <= _limits[_currentLine] || _currentString == ""
        _currentString = _stringToCheck
      else
        break
    }

    if _line > 0; _result = _result + "\n"

    _result = _currentString

    if _wordindex >= _wordcount; break
  }

  // If words remain, append them rather than silently discarding text.
  while _wordindex < _wordcount
  {
    _result = _result + " " + _words[_wordindex]
    _wordindex++
  }

  _result
}


//=== Centered Dialogue for Comic Balloon ===

OnNotifyBalloonInfo
{
	ComicBalloon = (reference0 == "Starberries Comic Balloon")
}

CenterText
{
	_align = "\f[align,center]"
	_talk = _align + REPLACE(_argv[0], "\n", _align + "\n")
	_talk
}


CalculateTextLines
{
	_text = _argv[0]
	_clean = RemoveSakuraScript(_text)
	_breaks = CountSubstring(_text, "\n")
	_len = STRLEN(_clean)
	_lines = CEIL(_len / 30) + _breaks + 1

  _lines
}

ChooseBalloon
{
	// Scuffed as hell way of "centering" the text vertically but it works for now
	_text = _argv[0]
  _lines = CalculateTextLines(_text)
  _b = 0
	_buffer = ""
  _result = ""

	if _lines >= 10 // 10, 11
	{
		if _lines == 10; _buffer = "\n"
		if _lines == 11; _buffer = "\n[half]"
    _b = 2
	}
	elseif _lines >= 8 // 8, 9
	{
		if _lines == 8; _buffer = "\n\n[half]"
    _b = 4
	}
	elseif _lines >= 6 // 6, 7
	{
		// if _lines == 6; _buffer = "\n[half]"
    _b = 6
	}
	elseif _lines <= 3 // 1,2,3
	{
		if _lines == 1; _buffer = "\n[half]"
		if _lines == 2; _buffer = "\n[25]"
    _b = 8
	}
	else // 4, 5
	{
		if _lines == 4; _buffer = "\n[75]"
    // _b = 0
		if _lines == 5; _buffer = "\n"
	}
  _result = TOINT(_lines) + "\b%(_b)" + _buffer
  _result
}

CountSubstring
{
		_text = _argv[0]
		_search = _argv[1]
		_count = 0
		_pos = 0

		while _pos >= 0
		{
			_pos = STRSTR(_text, _search, _pos)
			if _pos < 0
			{
				break
			}
			_count++
			_pos += STRLEN(_search)

		}

		_count
}

// Remove Sakura Script commands.
RemoveSakuraScript
{
    _text = RE_REPLACE(_argv[0], '\\_{0,2}[a-zA-Z0-9*!&-](\d|\[("([^"]|\\")+?"|([^\]]|\\\])+?)+?\])?', '')
    _text = REPLACE(_text, '\\', '\')
    _text
}