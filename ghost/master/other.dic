OnTranslate
{
	_talk = reference0
	
	if reference1 == "" && reference2 == ""
	{
		_talk = EVAL('"' + REPLACE(_talk,'"','""') + '"')
	}
	
	if ComicBalloon
	{
		_talk = CenterText(_talk)
		_talk = ChooseBalloon(_talk) + _talk
	}

	TOSTR(_talk)
}


//This is just here so you can use anchors to link to websites if you want. You can link to websites with normal menu choice tags! If you do, a handy URL preview will show up in the balloon!
OnAnchorSelect
{
	if "http://" _in_ reference0 || "https://" _in_ reference0; "\j[""%(reference0)""]"
}

//Hotkeys
OnKeyPress
{
	if reference0 == "f1"; "\![open,readme]"
	elseif reference0 == "t"; OnAiTalk
	elseif reference0 == "r"; OnLastTalk
}

//Happens about 30 seconds after a script ends, by default, to bring them back to normal poses
OnSurfaceRestore
{
	"\1\s[10]\0\s[0]"
}

//Happens when the ghost is unminimized. You can customize what surfaces are used here/if there's dialogue, but by default I've set it to just go to OnSurfaceRestore
OnWindowStateRestore
{
	OnSurfaceRestore
}

On_homeurl
{
	"https://raw.githubusercontent.com/starberries/ukagaka-bee/refs/heads/main/"
}

//—————————————————————————————— Right click menu links ——————————————————————————————

//Takes an array of alternating names and urls, and formats them for use with the right click menu
FormatLinks : all
{
	for _i = 0; _i < ARRAYSIZE(_argv); _i++
	{
		_argv[_i] //Add the link/title
		//Alternate between adding %ASC(1) or %ASC(2)
		if _i % 2 == 1; "%ASC(2)"
		else; "%ASC(1)"
	}
}

On_sakura.recommendsites
{
	FormatLinks(recommendsites_sakura)
}

recommendsites_sakura : array
{
	"ComicFury";	"https://comicfury.com/"
	"NamiComi"; "https://namicomi.com/en"
	"TopWebcomics"; "https://topwebcomics.com/?home=3"
}

On_sakura.portalsites 
{
	FormatLinks(portalsites_sakura)
}

portalsites_sakura : array
{
	"On Starlit Tides";	"https://on-starlit-tides.thecomicseries.com/"
}

On_kero.recommendsites
{
	FormatLinks(recommendsites_kero)
}

recommendsites_kero : array
{
	"These labels can be anything you want";	"https://link.example.com/link/to/whatever/here/once/more/"
}


//—————————————————————————————— User pronoun related ——————————————————————————————

they
{
	if SHIORI3FW.UserSex == "male"; "he"
	elseif SHIORI3FW.UserSex == "female"; "she"
	else; "they"
}

them
{
	if SHIORI3FW.UserSex == "male"; "him"
	elseif SHIORI3FW.UserSex == "female"; "her"
	else; "them"
}

their
{
	if SHIORI3FW.UserSex == "male"; "his"
	elseif SHIORI3FW.UserSex == "female"; "her"
	else; "their"
}

theirs
{
	if SHIORI3FW.UserSex == "male"; "his"
	elseif SHIORI3FW.UserSex == "female"; "hers"
	else; "theirs"
}

themself
{
	if SHIORI3FW.UserSex == "male"; "himself"
	elseif SHIORI3FW.UserSex == "female"; "herself"
	else; "themself"
}

//%(they) %(p('are','is'))
//You can change the name of this function if you want! I kept it short so it's fast to type
p
{
	if SHIORI3FW.UserSex == "undef"; _argv[0] //they are
	else; _argv[1] //he is/she is
}

username
{
	SHIORI3FW.UserName
}

// --- CENTERED DIALOGUE FOR COMIC BALLOON ---

OnNotifyBalloonInfo
{
	ComicBalloon = (reference0 == "Starberries Comic Balloon")
}

CenterText
{
	_align = "\f[align,center]"
	_talk = _align + REPLACE(_argv[0], "\n", _align + "\n")
	_talk
}

ChooseBalloon
{
	// Scuffed as hell way of "centering" the text vertically but it works for now
	_text = _argv[0]
	_clean = RemoveSakuraScript(_text)
	_breaks = CountSubstring(_text, "\n")
	_len = STRLEN(_clean)
	_lines = CEIL(_len / 28) + _breaks + 1
	_buffer = ""

	if _lines >= 10 // 10, 11
	{
		if _lines == 10; _buffer = "\n"
		if _lines == 11; _buffer = "\n[half]"
		"\b[2]" + _buffer
	}
	elseif _lines >= 8 // 8, 9
	{
		if _lines == 8; buffer = "\n\n[half]"
		"\b[4]" + _buffer
	}
	elseif _lines >= 6 // 6, 7
	{
		if _lines == 6
		{
			_buffer = "\n[half]"
		}
		"\b[6]" + _buffer
	}
	elseif _lines <= 3 // 1,2,3
	{
		if _lines == 1; buffer = "\n\n[half]"
		if _lines == 2; buffer = "\n"
		"\b[8]" + _buffer
	}
	else // 4, 5
	{
		if _lines == 4; _buffer = "\n"
		if _lines == 5; _buffer = "\n[half]"
		"\b[0]" + _buffer
	}
}

CountSubstring
{
		_text = _argv[0]
		_search = _argv[1]
		_count = 0
		_pos = 0

		while _pos >= 0
		{
			_pos = STRSTR(_text, _search, _pos)
			if _pos < 0
			{
				break
			}
			_count++
			_pos += STRLEN(_search)

		}

		_count
}

// Remove Sakura Script commands.
RemoveSakuraScript
{
    _text = RE_REPLACE(_argv[0], '\\_{0,2}[a-zA-Z0-9*!&-](\d|\[("([^"]|\\")+?"|([^\]]|\\\])+?)+?\])?', '')
    _text = REPLACE(_text, '\\', '\')
    _text
}