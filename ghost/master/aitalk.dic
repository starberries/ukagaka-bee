OnAiTalk
{
	if CHAIN.IDName != ""
	{
		LastTalk = ChainTalk
	}
	else
	{
		LastTalk = RandomTalkSub
	}
	LastTalk
}

TestTalk : nonoverlap_pool
{
	{
		_meal = MealChoice
		"\0\s[gaming]I think I want %(_meal[1]) for %(_meal[0])..."
	}
}

RandomTalkParallel
{
	// Check if _argv0 is a function
	if ISFUNC(_argv[0]) {
		// evaluate the arg (for templates etc)
		_var = EVAL(_argv[0])
		_type = GETTYPE(_var)

		// array = returns the named array
		if _type == 4 {
			_var
		}
		// error/failure = returns empty aray
		elseif _type == 0 {
			IARRAY
		}
		// other = check that _var is a non-empty string
		else {
			CVSTR(_var)
			if STRLEN(_var) {
				// non-empty = return array of the arg name and an empty array
				(_var,IARRAY)
			}
			else {
				// return an empty array
				IARRAY
			}
		}
	}
	else {
		IARRAY
	}
}

RandomTalkSubArray: array
{

	// Weekday Dialogue
	if weekday == 5
		parallel RandomTalkParallel("RandomTalkSub_Friday")
	elseif weekday == 6
		parallel RandomTalkParallel("RandomTalkSub_Saturday")
	elseif weekday == 6 || weekday == 7
		parallel RandomTalkParallel("RandomTalkSub_Weekend")
	else
		parallel RandomTalkParallel("RandomTalkSub_Weekday")

	_s  = GetSeason
	_sd = GetSeasonDetail
	_t  = GetTimeSlot
	_m = month
	
	// === Seasonal Dialogue ===
	parallel RandomTalkParallel("RandomTalkSub_%(_s)")
	parallel RandomTalkParallel("RandomTalkSub_%(_s)_%(_t)")
	parallel RandomTalkParallel("RandomTalkSub_%(_sd)")
	parallel RandomTalkParallel("RandomTalkSub_%(_sd)_%(_t)")
	
	// === Time-Based Dialogue ===
	parallel RandomTalkParallel("BootRandomTalkSub_%(_t)")
	parallel RandomTalkParallel("RandomTalkSub_%(_t)")
	
	// === Month Dialogue ===
	parallel RandomTalkParallel("RandomTalkSub_%(_m)")
	_tmparray = IARRAY
	if day <= 15 {
		_tmparray = RandomTalkParallel("RandomTalkSub_%(_m)_firsthalf")
	}
	else {
		_tmparray = RandomTalkParallel("RandomTalkSub_%(_m)_secondhalf")
	}
	parallel _tmparray

	// === Holiday/Special Date Dialogue ===
	parallel RandomTalkParallel("RandomTalkSub_Holiday")

	// === Series Dialogue ==-
	// Masked Knight conversation series
	parallel RandomTalkParallel("RandomTalkSeries")

	// === Everyday Dialogue ===
	parallel RandomTalkParallel("RandomTalkNormal")
}

RandomTalkSub : nonoverlap_pool
{
	parallel RandomTalkSubArray
}