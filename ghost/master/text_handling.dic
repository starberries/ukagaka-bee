GetCharWidth {
  _char = _argv[0]

  case _char {
    when "i", "j", "l", "I", ".", ",", "!", ";", "'"
      1
    when "J", "1", "-", "*", "(", ")", '"', "/", "|"
      2
    when "g", "m", "w", "M", "Q", "@"
      4
    when "W"
      5
    others
      3
  }
}

GetStringWidth {
  _text = RemoveSakuraScript(_argv[0])
  _width = 0

  for _i; _i < STRLEN(_text); _i++ {
    _char = SUBSTR(_text, _i, 1)
    _width += GetCharWidth(_char)
  }

  _width
}

GetDiamondLineWidth {
  _line = _argv[0]
  _lines = _argv[1]
  _baseWidth = maxLineWidth

  // Distance from middle line(s).
  _distance = _line
  if _lines - 1 - _line < _distance {
    _distance = _lines - 1 - _line
  }

  _factor = 1.0
  case _distance {
    when 1; _factor = 0.8
    when 2; _factor = 0.65
    when 3; _factor = 0.5
    when 4; _factor = 0.4
    when 5; _factor = 0.3
    others; _factor = 0.25
  }

  ROUND(_baseWidth * _factor)
}

CalculateLineCount {
  _text = _argv[0]
  _width = GetStringWidth(_text)
  _maxWidth = 81
  _currentLine = 0
  _lineWidth = _maxWidth
  _expectedLines = 1

  _leftover = _width
  while _leftover > _maxWidth {
    if ROUND(_leftover / 2) <= _maxWidth {
      _expectedLines++
      break
    } else {
      _maxWidth -= ROUND(_maxWidth * (_currentLine * 0.2)) // Get current line max width
      _leftover -= _maxWidth * 2 // Deduct current max width from leftover width for two lines
      _expectedLines += 2
    }
  }

  _expectedLines = AdjustLineCount(_text, _expectedLines)
  
  _expectedLines
}

AdjustLineCount {
  _text = _argv[0]
  _lines = _argv[1]
	_breaks = CountSubstring(_text, "\n")
	_pipes = CountSubstring(_text, "||")
  _lines += _breaks + _pipes

  _lines
}

WrapDiamondText {
  _text = _argv[0]
  _lines = _argv[1]

  if _lines < 1 {
    _lines = 1
  }

  _retry = 0
  _done = 0
  _result = _text

  _lines +": "+_text

  while !_done && _retry < 100 {
    _remaining = _text
    _wrapped = ""
    _line = 0
    _failed = 0

    // Attempt to fit the text into the requested number of lines.
    while _line < _lines && STRLEN(_remaining) > 0 {
      _maxWidth = GetDiamondLineWidth(_line, _lines)
      _remainingLength = STRLEN(_remaining)

      _width = 0
      _i = 0
      _lastSpace = -1
      _excess = 0

      // Scan characters until the next one would exceed the width.
      while _i < _remainingLength && _excess == 0 {
        _char = SUBSTR(_remaining, _i, 1)
        _charWidth = GetCharWidth(_char)

        if _width + _charWidth > _maxWidth {
          _excess = 1
        } else {
          _width += _charWidth

          if _char == " " {
            _lastSpace = _i
          }

          _i++
        }
      }

      if _excess == 0 {
        // All remaining text fits on this line.
        _wrapped += _remaining
        _remaining = ""
      } else {
        if _lastSpace >= 0 {
          // Split text at the last whitespace tracked.
          _wrapped += SUBSTR(_remaining, 0, _lastSpace)
          _remaining = SUBSTR(_remaining, _lastSpace + 1, _remainingLength - _lastSpace - 1)
        } else {
          // No whitespace fits: keep the longest fitting prefix.
          // Force one character if even the first character is too wide.
          if _i == 0; _i = 1

          _wrapped += SUBSTR(_remaining, 0, _i)
          _remaining = SUBSTR(_remaining, _i, _remainingLength - _i)
        }
      }

      _line++

      if STRLEN(_remaining) > 0 {
        _wrapped += "\n"
      }
    }

    // Decide whether the line count was appropriate.
    if STRLEN(_remaining) > 0 {
      // Not enough lines; try a taller diamond.
      _lines++
    } else {
      if _line < _lines {
        // Text ran out early; try a shorter diamond.
        _lines--
      } else {
        _result = _wrapped
        _done = 1
      }
    }

    _retry++
  }

  _result
}


//=== Centered Dialogue for Comic Balloon ===

OnNotifyBalloonInfo
{
	ComicBalloon = (reference0 == "Starberries Comic Balloon")
}

CenterText
{
	_align = "\f[align,center]"
	_talk = _align + REPLACE(_argv[0], "\n", _align + "\n")
	_talk
}

DiamondWrapLineBreaks
{
	_text = _argv[0]
	if ComicBalloon {
		_text = REPLACE(_text, "||", "\n")
		_text = REPLACE(_text, "|", "\n")
	} else { 
		_text = REPLACE(_text, '||', " ")
		_text = REPLACE(_text, '|', " ")
	}
	_text
}

	// Scuffed as hell way of "centering" the text vertically but it works for now
CalculateTextLines
{
	_text = _argv[0]
	_clean = RemoveSakuraScript(_text)
	_breaks = CountSubstring(_text, "\n")
	_pipes = CountSubstring(_text, "||")
	_len = STRLEN(_clean)
	_lines = CEIL(_len / 30) + _breaks + _pipes + 1
	_lines
}

ChooseBalloon
{
  _text = _argv[0]
  _width = GetStringWidth(_text)
  _lines = CalculateLineCount(_text)

	_buffer = ""
	_b = 0

	if _lines >= 10 // 10, 11
	{
		if _lines == 10; _buffer = "\n[110]"
		if _lines == 11; _buffer = "\n[70]"
		_b = 2
	}
	elseif _lines >= 8 // 8, 9
	{
		if _lines == 8; _buffer = "\n[70]"
		if _lines == 9; _buffer = "\n[30]"
		_b = 4
	}
	elseif _lines >= 6 // 6, 7
	{
		if _lines == 6; _buffer = "\n[90]"
		if _lines == 7; _buffer = "\n[50]"
		_b = 6
	}
	elseif _lines <= 3 // 1,2,3
	{
		if _lines == 1; _buffer = "\n[100]"
		if _lines == 2; _buffer = "\n[60]"
		if _lines == 3; _buffer = "\n[20]"
		_b = 8
	}
	else // 4, 5
	{
		if _lines == 4; _buffer = "\n[110]"
		if _lines == 5; _buffer = "\n[70]"
		_b = 0
	}

	_result = "\b[%(_b)]" + _buffer
  _result
}

CountSubstring
{
		_text = _argv[0]
		_search = _argv[1]
		_count = 0
		_pos = 0

		while _pos >= 0
		{
			_pos = STRSTR(_text, _search, _pos)
			if _pos < 0
			{
				break
			}
			_count++
			_pos += STRLEN(_search)

		}

		_count
}

// Remove Sakura Script commands.
RemoveSakuraScript
{
    _text = RE_REPLACE(_argv[0], '\\_{0,2}[a-zA-Z0-9*!&-](\d|\[("([^"]|\\")+?"|([^\]]|\\\])+?)+?\])?', '')
    _text = REPLACE(_text, '\\', '\')
    _text
}