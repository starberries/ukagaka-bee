// reference3 = which character is clicked
// reference4 = which hitbox mouse is hovering
// reference5 = which mouse button is clicked

OnMouseDoubleClick
{
	if reference5 == 0
	{
		if reference3 == 0
		{
			OnSakuraMenu
		}
		else
		{
			OnKeroMenu
		}
	}
}

OnMouseMove
{
	if reference4 != ""
	{
		stroke++
		
		if stroke % 40 == 0
		{
			if reference3 == 0; OnMouseMove.Sakura
			else; OnMouseMove.Kero
		}
	}
}

OnMouseMove.Sakura
{
	if reference4 == "head"
	{
		"\0\s[proud]That's actually pretty nice."
	} 

	if reference4 == "earL" || reference4 == "earR"
	{
		"\0\s[proud]Aren't my ears soft?"
	}
}

OnMouseClick
{
	if reference3 == 0 && reference4 == "nose"
	{
		"\0\s[surprise]Boop?!"
	}
}

OnMouseMove.Kero
{
	if reference4 == "head"
	{
		"\1\s[10]Petting..."
	}
}

OnMouseLeaveAll
{
	stroke = 0
}