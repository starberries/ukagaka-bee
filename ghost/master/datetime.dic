// === From YAYA Docs, Gregorian date to Julian date ===
J_DATE
{
	_y = TOINT(_argv[0])
	_m = TOINT(_argv[1])
	_d = TOINT(_argv[2])

	_result = _d-32075+TOINT(1461*(_y+4800+TOINT((_m-14)/12))/4)+TOINT(367*(_m-2-TOINT((_m-14)/12)*12)/12)-TOINT(3*(TOINT((_y+4900+TOINT((_m-14)/12))/100))/4)

	_result
}

// === Julian to Gregorian date ===
// praying to the spirits this is cobbled together correctly
DATE_J
{
	_j = TOINT(_argv[0])

	_a = _j + 32044
	_b = TOINT((4 * _a + 3) / 146097)
	_c = _a - TOINT(146097 * _b / 4)
	_d = TOINT((4 * _c + 3) / 1461)
	_e = _c - TOINT(1461 * _d / 4)
	_m = TOINT((5 * _e + 2) / 153)

	_day = _e - TOINT((153 * _m + 2) / 5) + 1
	_day_str = TOSTR(_day)
	_month = _m + 3 - 12 * TOINT(_m / 10)
	_month_str = TOSTR(_month)
	_year = 100 * _b + _d - 4800 + TOINT(_m / 10)

	if _month < 10
		_month_str = "0" + _month_str

	if _day < 10
		_day_str = "0" + _day_str

	_result = (TOSTR(_year) + _month_str + _day_str)
	_result
}

// === Get the next valid Saturday ===
NextSaturday
{
	_date = TOSTR(_argv[0])
	_result = ""

	// MMDDYYYY
	if STRLEN(_date) != 8 {
		_result = ""
	} else {
		// Checking the input can be read as an integer
		if !ISINTSTR(_date) {
			_result = ""
		} else {
			_year = TOINT(SUBSTR(_date, 0, 4))
			_month = TOINT(SUBSTR(_date, 4, 2))
			_day = TOINT(SUBSTR(_date, 6, 2))

			// Checking for invalid inputs
			if _year < 1 || _month < 1 || _month > 12 || _day < 1 || _day > 31 {
					_result = ""
			} else {
				_j = J_DATE(_year, _month, _day)

				// Check for invalid whole dates (ie February 30th or April 31st)
				_check = DATE_J(_j)

				if _check != _date {
					_result = ""
				} else {
					_weekday = _j % 7
					_add = (5 - _weekday + 7) % 7

					_result = DATE_J(_j + _add)
				}
			}
		}
	}

	_result
}

// === Get General Time ===
GetTime
{
	_time = hour * 100 + minute
	_time
}

GetTimeSlot
{
	case GetTime
	{
		when 500-799; "earlymorning"
		when 800-1099; "morning"
		when 1100-1299; "midday"
		when 1300-1699; "afternoon"
		when 1700-2299; "night"
		others; "midnight"
	}
}

GetSchoolHours
{
	if !GetWeekday
	{
		case GetTime
		{
			when 830-844; "homeroom"
			when 845-944; "class_1"
			when 945-1044; "class_2"
			when 1045-1144; "class_3"
			when 1145-1229; "lunch_break"
			when 1230-1329; "class_4"
			when 1330-1429; "class_5"
			when 1430-1529; "class_6"
			others; 0
		}
	} else; 0
}

GetWeekday
{
	case weekday
	{
		when 1; "monday"
		when 2; "tuesday"
		when 3; "wednesday"
		when 4; "thursday"
		when 5; "friday"
		when 6; "saturday"
		others; "sunday"
	}
}

GetIsWeekend
{
	if weekday == 0 || weekday == 6; 1; else; 0
}

// === Get General Season ===
GetSeason
{
	case month
	{
		when 3-5; "spring"
		when 6-8; "summer"
		when 9-11; "fall"
		others; "winter"
	}
}

GetSeasonDetail
{
	case month {
		when 1; "mid_winter"
		when 2; "late_winter"
		when 3; "early_spring"
		when 4; "mid_spring"
		when 5; "late_spring"
		when 6; "early_summer"
		when 7; "mid_summer"
		when 8; "late_summer"
		when 9; "early_fall"
		when 10; "mid_fall"
		when 11; "late_fall"
		when 12; "early_winter"
	}
}