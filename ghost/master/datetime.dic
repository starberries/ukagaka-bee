// === Get General Time ===
GetTime
{
	_time = hour * 100 + minute
	_time
}

GetTimeSlot
{
	case GetTime
	{
		when 500-799; "earlymorning"
		when 800-1099; "morning"
		when 1100-1299; "midday"
		when 1300-1699; "afternoon"
		when 1700-2299; "night"
		others; "midnight"
	}
}

GetSchoolHours
{
	if !GetWeekday
	{
		case GetTime
		{
			when 830-844; "homeroom"
			when 845-944; "class_1"
			when 945-1044; "class_2"
			when 1045-1144; "class_3"
			when 1145-1229; "lunch_break"
			when 1230-1329; "class_4"
			when 1330-1429; "class_5"
			when 1430-1529; "class_6"
			others; 0
		}
	} else; 0
}

GetWeekday
{
	case weekday
	{
		when 1; "monday"
		when 2; "tuesday"
		when 3; "wednesday"
		when 4; "thursday"
		when 5; "friday"
		when 6; "saturday"
		others; "sunday"
	}
}

GetIsWeekend
{
	if weekday == 0 || weekday == 6; 1; else; 0
}

// === Get General Season ===
GetSeason
{
	case month
	{
		when 3-5; "spring"
		when 6-8; "summer"
		when 9-11; "fall"
		others; "winter"
	}
}

GetSeasonDetail
{
	case month {
		when 1; "mid_winter"
		when 2; "late_winter"
		when 3; "early_spring"
		when 4; "mid_spring"
		when 5; "late_spring"
		when 6; "early_summer"
		when 7; "mid_summer"
		when 8; "late_summer"
		when 9; "early_fall"
		when 10; "mid_fall"
		when 11; "late_fall"
		when 12; "early_winter"
	}
}